{
	"name": "kruithne.net",
	"module": "server.ts",
	"devDependencies": {
		"@types/bun": "^1.2.15"
	},
	"spooder": {
		"auto_restart": {
			"enabled": true,
			"max_attempts": -1,
			"backoff_max": 300000,
			"backoff_grace": 30000
		},
		"run": "bun run server.ts",
		"update": [
			"git fetch --depth=1 origin main",
			"git reset --hard origin/main",
			"git clean -fd",
			"git submodule update --init --recursive",
			"bun install"
		],
		"canary": {
			"enabled": true,
			"account": "kruithne",
			"repository": "kruithne/kruithne.net",
			"crash_console_history": 64,
			"labels": ["⚠️ canary-report"],
			"throttle": 86400
		}
	},
	"type": "module",
	"dependencies": {
		"spooder": "^6.1.5"
	}
}